(ns mongol-drafts.states.draft
  (:require
   [mongol-drafts.services.draft :as draft-service]
   [mongol-drafts.services.workspace :as workspace-service]
   [mongol-drafts.states.global :as gs]
   [mongol-drafts.states.counter :as counter-state]))

(defn- ensure-workspace-id []
  (if-let [workspace-id (get (:workspace @gs/state) "id")]
    workspace-id
    (let [workspace (await (workspace-service/get-or-create-default))]
      (swap! gs/state assoc :workspace workspace)
      (get workspace "id"))))

(defn set-current-draft [controller id]
  (let [result (await (draft-service/get-draft id))
        draft (-> result first .-data)]
    (set! (.-text controller) (get draft "content"))
    (swap! gs/state assoc :draft draft)
    (counter-state/count-contents gs/state (get draft "content"))))

(defn set-current-draft-without-controller [id]
  (let [result (await (draft-service/get-draft id))
        draft (-> result first .-data)]
    (swap! gs/state assoc :draft draft)))

(defn- apply-draft [draft]
  (swap! gs/state assoc :draft draft)
  (counter-state/count-contents gs/state (get draft "content")))

(defn- blank-content? [content]
  (or (nil? content) (empty? content)))

(defn new-draft []
  (let [result (await (draft-service/last-draft))
        last (some-> result first .-data)]
    (if (and last
             (blank-content? (get last "content"))
             (not= -1 (get last "status")))
      (apply-draft last)
      (let [workspace-id (await (ensure-workspace-id))
            row (await (draft-service/create-draft workspace-id ""))]
        (apply-draft (.-data row))))))

(defn ensure-current-draft []
  (when-not (:draft @gs/state)
    (let [result (await (draft-service/latest-draft))]
      (if (not-empty result)
        (apply-draft (-> result first .-data))
        (let [workspace-id (await (ensure-workspace-id))
              row (await (draft-service/create-draft workspace-id ""))]
          (apply-draft (.-data row)))))))

(defn- draft-contents []
  (or (get-in @gs/state [:drafts :contents]) []))

(defn- without-draft-id [id]
  (into [] (remove #(= id (get % "id")) (draft-contents))))

(defn- dissociate-draft [id]
  (swap! gs/state assoc-in [:drafts :contents] (without-draft-id id)))

(defn delete-draft [i]
  (let [id (-> (draft-contents) (nth i) (get "id"))
        current? (= id (get (:draft @gs/state) "id"))]
    (dissociate-draft id)
    (await (draft-service/delete-draft id))
    current?))

(defn- put-draft-field [draft k v]
  (doto (Map/from draft)
    (.update k (fn [_] v))))

(defn- prepend-draft [draft]
  (let [id (get draft "id")]
    (when-not (some #(= id (get % "id")) (draft-contents))
      (swap! gs/state assoc-in [:drafts :contents]
             (into [draft] (draft-contents))))))

(defn flagged? [flag]
  (or (true? flag) (= 1 flag)))

(defn update-draft [content]
  (let [draft (:draft @gs/state)
        id (get draft "id")
        recycled? (= -1 (get draft "status"))]
    (await (draft-service/update-draft id content))
    (let [next (cond-> (put-draft-field draft "content" content)
                 recycled? (put-draft-field "status" 0))
          tab (:draft/tabbar-index @gs/state)]
      (swap! gs/state assoc :draft next)
      (when recycled?
        (cond
          (= 3 tab)
          (dissociate-draft id)

          (= 0 tab)
          (prepend-draft next)

          (and (= 1 tab) (flagged? (get next "flag")))
          (prepend-draft next)))
      (counter-state/count-contents gs/state content))))

(defn list-drafts [state]
  (let [;num (-> @state :drafts :contents count)
        flag (:draft/flag @state)
        status (:draft/status @state)
        drafts (await (draft-service/list-drafts [] [] flag status))]
    (if (empty? drafts)
      (do
        (swap! state assoc-in [:drafts :is-end] true)
        (swap! state assoc-in [:drafts :contents] []))
      (do
        (swap! state assoc-in [:drafts :is-end] false)
        (swap! state assoc-in [:drafts :contents]
               (concat (get-in @state [:drafts :contents]) (map (fn [x] (.-data x)) drafts)))))))

(defn query-drafts [q has-filter]
  (if (empty? q)
    (let [;num (-> @state :draft :contents count)
          tag-in-ids (map #(get % "id") (:filter-tags @gs/state))
          tag-out-ids (map #(get % "id") (:omitted-tags @gs/state))
          flag (:draft/flag @gs/state)
          status (:draft/status @gs/state)
          drafts (await (draft-service/list-drafts
                         (if has-filter tag-in-ids [])
                         (if has-filter tag-out-ids [])
                         flag status))]
      (if (empty? drafts)
        (do
          (swap! gs/state assoc-in [:drafts :is-end] true)
          (swap! gs/state assoc-in [:drafts :contents] []))
        (do
          (swap! gs/state assoc-in [:drafts :is-end] false)
          (swap! gs/state assoc-in [:drafts :contents]
                 (into [] (map (fn [x] (.-data x)) drafts))))))
    (let [;num (-> @state :draft :contents count)
          tag-in-ids (map #(get % "id") (:filter-tags @gs/state))
          tag-out-ids (map #(get % "id") (:omitted-tags @gs/state))
          flag (:draft/flag @gs/state)
          status (:draft/status @gs/state)
          drafts (await (draft-service/query-drafts
                         q
                         (if has-filter tag-in-ids [])
                         (if has-filter tag-out-ids [])
                         flag status))]
      (if (empty? drafts)
        (do
          (swap! gs/state assoc-in [:drafts :is-end] true)
          (swap! gs/state assoc-in [:drafts :contents] []))
        (do
          (swap! gs/state assoc-in [:drafts :is-end] false)
          (swap! gs/state assoc-in [:drafts :contents]
                 (into [] (map (fn [x] (.-data x)) drafts))))))))

(defn clear-drafts []
  (swap! gs/state assoc-in [:drafts :is-end] false)
  (swap! gs/state assoc-in [:drafts :contents] []))

;;;;;
(defn focus-on-draft [controller]
  (swap! gs/state assoc :show-keyboard true)
  (when (true? (:tag-on-edit @gs/state))
    (swap! gs/state assoc :tag-on-edit false))
  (let [text (-> @gs/state :draft (get "content"))]
    (set! (.-text controller) text)))

(defn initial-states []
  {:tag-viewable false
   :show-keyboard false
   :show-stacked-keyboard false
   :show-drawer-search false
   :show-sub-drawer-search false
   :show-search-dialog false
   :tag-on-edit false
   :current-layout "mn"})

(defn set-draft-search-status [i]
  (when-not (= i (:draft/tabbar-index @gs/state))
    (swap! gs/state assoc :draft/tabbar-index i)
    (condp = i
      ;; Query Inbox drafts
      0
      (do
        (swap! gs/state assoc :draft/flag nil)
        (swap! gs/state assoc :draft/status 0)
        (query-drafts (:draft-search @gs/state) true))

      ;; Query Flaged drafts
      1
      (do
        (swap! gs/state assoc :draft/flag 1)
        (swap! gs/state assoc :draft/status 0)
        (query-drafts (:draft-search @gs/state) true))

      ;; Query Archived drafts
      2
      (do
        (swap! gs/state assoc :draft/flag nil)
        (swap! gs/state assoc :draft/status 1)
        (query-drafts (:draft-search @gs/state) true))

      ;; Query All drafts
      ;; 3
      ;; (do
      ;;   (swap! state assoc :draft/flag nil)
      ;;   (swap! state assoc :draft/status nil)
      ;;   (query-drafts state (:draft-search @state) true))

      ;; Query Deleted drafts
      3
      (do
        (swap! gs/state assoc :draft/flag nil)
        (swap! gs/state assoc :draft/status -1)
        (query-drafts (:draft-search @gs/state) true)))))

(defn toggle-draft-flag [id]
  (let [on? (flagged? (-> @gs/state :draft (get "flag")))]
    (if on?
      (draft-service/unflag-draft id)
      (draft-service/flag-draft id))
    (swap! gs/state assoc :draft
           (doto
            (-> @gs/state :draft)
             (.update
              "flag"
              (fn [_] (not on?)))))))

(defn- draft-with-flag [draft flagged?]
  (doto (Map/from draft)
    (.update "flag" (fn [_] flagged?))))

(defn toggle-drafts-item-flag [i]
  (let [draft (-> @gs/state :drafts :contents (nth i))
        id (get draft "id")
        on? (flagged? (get draft "flag"))
        next-flag (not on?)]
    (if on?
      (draft-service/unflag-draft id)
      (draft-service/flag-draft id))
    (if (and on? (= 1 (:draft/tabbar-index @gs/state)))
      (dissociate-draft id)
      (swap! gs/state assoc-in [:drafts :contents i]
             (draft-with-flag draft next-flag)))
    (when (= id (get (:draft @gs/state) "id"))
      (swap! gs/state assoc :draft
             (draft-with-flag (:draft @gs/state) next-flag)))))

(defn recycle-draft [i]
  (let [id (-> (draft-contents) (nth i) (get "id"))]
    (dissociate-draft id)
    (await (draft-service/recycle-draft id))
    (when (= id (get (:draft @gs/state) "id"))
      (swap! gs/state assoc :draft
             (put-draft-field (:draft @gs/state) "status" -1)))))

(defn archive-draft [i]
  (let [id (-> (draft-contents) (nth i) (get "id"))]
    (dissociate-draft id)
    (await (draft-service/archive-draft id))))

(defn inbox-draft [i]
  (let [id (-> (draft-contents) (nth i) (get "id"))]
    (dissociate-draft id)
    (await (draft-service/inbox-draft id))))

