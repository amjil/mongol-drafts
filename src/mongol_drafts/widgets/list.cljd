(ns mongol-drafts.widgets.list
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:flutter_slidable/flutter_slidable.dart" :as slidable]
   [cljd.flutter :as f]
   [components.tokens :as tokens]
   [mongol-drafts.widgets.empty :as empty-content]
   [mongol-drafts.states.global :as global-state]
   [mongol-drafts.states.draft :as draft-state]
   [mongol-drafts.states.font :as font-state]
   [mongol-drafts.states.tag :as tag-state]))

(defn- pad2 [n]
  (if (< n 10) (str "0" n) (str n)))

(defn- as-date-time [v]
  (cond
    (nil? v) nil
    (instance? DateTime v) v
    (number? v)
    (DateTime/fromMillisecondsSinceEpoch
     (if (>= v 1000000000000) v (* v 1000)))
    :else
    (let [s (str v)]
      (when (>= (count s) 8)
        (try
          (DateTime/parse s)
          (catch Exception _ nil))))))

(defn- short-date [v]
  (when-let [dt (as-date-time v)]
    (str (pad2 (.-month dt)) "-" (pad2 (.-day dt)))))

(defn- open-draft [navigator text-controller draft]
  (draft-state/set-current-draft text-controller (get draft "id"))
  (if (true? (:show-search-dialog @global-state/state))
    (do
      (swap! global-state/state assoc :show-search-dialog false)
      (swap! global-state/state assoc :show-stacked-keyboard false))
    (.pop navigator))
  (draft-state/focus-on-draft text-controller)
  (tag-state/get-draft-tags global-state/state (get draft "id")))

(defn- action [icon color on-pressed]
  (slidable/SlidableAction
   .onPressed (fn [_] (on-pressed))
   .autoClose true
   .backgroundColor color
   .foregroundColor (.white m/Colors)
   .padding (m.EdgeInsets/all 0)
   .icon icon
   .label nil))

(defn- item-actions [i text-controller]
  (let [tab (:draft/tabbar-index @global-state/state)]
    (vec
     (remove nil?
             [(when (not= tab 3)
                (action m/Icons.flag (.green m/Colors)
                        #(draft-state/toggle-drafts-item-flag i)))
              (when (some #{tab} [2 3])
                (action m/Icons.inbox_outlined (.blue m/Colors)
                        #(draft-state/inbox-draft i)))
              (when (not= tab 3)
                (action m/Icons.delete (.red m/Colors)
                        (fn []
                          (let [id (-> @global-state/state :drafts :contents (nth i) (get "id"))]
                            (await (draft-state/recycle-draft i))
                            (when (= id (-> @global-state/state :draft (get "id")))
                              (await (draft-state/new-draft))
                              (draft-state/focus-on-draft text-controller))))))
              (when (some #{tab} [0 1])
                (action m/Icons.archive (.blue m/Colors)
                        #(draft-state/archive-draft i)))
              (when (= tab 3)
                (action m/Icons.delete_forever (.red m/Colors)
                        #(draft-state/delete-draft i)))]))))

(defn- draft-card [context draft selected? draft-font on-tap]
  (let [scheme (-> m/Theme (.of context) .-colorScheme)
        theme (-> m/Theme (.of context))
        blank? (empty? (get draft "content"))
        content (if blank?
                  "᠁"
                  (.trim ^String (or (get draft "content") "")))
        flagged? (draft-state/flagged? (get draft "flag"))
        date (short-date (or (get draft "updated_at") (get draft "updatedAt")))
        radius (tokens/radius :m)
        border-color (if selected?
                       (-> theme .-iconTheme .-color)
                       (.-outlineVariant scheme))]
    (m/Material
     .color (.-cardColor theme)
     .elevation (if selected? 2.0 0.0)
     .shadowColor (-> m.Colors/black (.withOpacity 0.18))
     .shape (m/RoundedRectangleBorder
             .borderRadius (.circular m/BorderRadius radius)
             .side (m/BorderSide
                    .width (if selected? 1.5 1.0)
                    .color border-color))
     .clipBehavior m/Clip.antiAlias
     .child
     (m/InkWell
      .onTap on-tap
      .child
      (m/Container
       .width 72
       .padding (.symmetric m/EdgeInsets .horizontal 10 .vertical 12)
       .child
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/spaceBetween
        .children
        [(m/Expanded
          .child
          (mgl/MongolText
           content
           .maxLines 1
           .overflow m/TextOverflow.fade
           .style (m/TextStyle
                   .fontFamily draft-font
                   .fontSize 16
                   .height 1.6
                   .color (if blank?
                            (-> ^m/Color (.-onSurfaceVariant scheme) (.withOpacity 0.45))
                            (.-onSurface scheme)))))
         (m/Column
          .children
          [(if flagged?
             (m/Padding
              .padding (.only m/EdgeInsets .bottom 6)
              .child
              (m/Icon m/Icons.flag
                      .size 14
                      .color (.-secondary scheme)))
             (m/SizedBox .height 0))
           (if date
             (m/RotatedBox
              .quarterTurns 1
              .child
              (m/Text date
                      .style (m/TextStyle
                              .fontSize 11
                              .letterSpacing 0.4
                              .color (.-onSurfaceVariant scheme)
                              .fontFamily "roboto")))
             (m/SizedBox .height 0))])]))))))

(defn widget []
  (f/widget
   :context ctx
   :get [m/Navigator :text-controller]
   :watch [{{contents :contents} :drafts
            draft :draft
            tab :draft/tabbar-index} global-state/state
           {draft-font :draft-font} font-state/font-state]
   :let [items (vec contents)
         current-id (get draft "id")
         empty-icon (condp = tab
                      1 m/Icons.flag_outlined
                      2 m/Icons.archive_outlined
                      3 m/Icons.delete_outline
                      m/Icons.inbox_outlined)]
   (if (empty? items)
     (empty-content/empty-content-view {:icon empty-icon})
     (m.ListView/separated
      .key (m/ValueKey (count items))
      .separatorBuilder (fn [_ _] (m/SizedBox .width (tokens/space :s)))
      .scrollDirection m.Axis/horizontal
      .padding (.fromLTRB m/EdgeInsets 16 12 16 12)
      .itemCount (count items)
      .itemBuilder
      (fn [^m/BuildContext context i]
        (let [item (nth items i)
              selected? (= current-id (get item "id"))]
          (slidable/Slidable
           .key (m/ValueKey (or (get item "id") i))
           .direction m/Axis.vertical
           .endActionPane
           (slidable/ActionPane
            .motion (slidable/BehindMotion)
            .children (item-actions i text-controller))
           .child
           (draft-card context item selected? draft-font
                       #(open-draft navigator text-controller item)))))))))
