(ns mongol-drafts.widgets.tabbar
  (:require
   ["package:flutter/material.dart" :as m]
   [cljd.flutter :as f]
   [mongol-drafts.widgets.list :as content-list]
   [mongol-drafts.states.draft :as draft-state]
   [mongol-drafts.states.global :as global-state]))

(declare tabbar-view)

(defonce ^:private attached-tab-controller (atom nil))

(defn- ensure-tab-listener [^m/TabController tab-controller]
  (when-not (identical? @attached-tab-controller tab-controller)
    (reset! attached-tab-controller tab-controller)
    (.addListener tab-controller
                  (fn []
                    (when-not (.-indexIsChanging tab-controller)
                      (draft-state/set-draft-search-status (.-index tab-controller)))))))

(defn tabbar []
  (f/widget
   :context ctx
   :let [initial-index (or (:draft/tabbar-index @global-state/state) 0)]
   (m/DefaultTabController
    .length 4
    .initialIndex initial-index
    .child
    (m/Builder
     .builder
     (fn [^m/BuildContext context]
       (let [tab-controller (.of m/DefaultTabController context)
             _ (ensure-tab-listener tab-controller)]
         (m/Column
          .children
          [(m/Row
            .children
            [(m/Expanded
              .child
              (m/TabBar
               .indicator (m/BoxDecoration
                           .borderRadius (.vertical m/BorderRadius
                                                    .bottom m.Radius/zero
                                                    .top (.circular m/Radius 10))
                           .color (-> m/Theme (.of ctx) .-colorScheme .-primaryContainer))
               .isScrollable true
               .tabs
               [(m/Tab
                 .icon
                 (m/Padding
                  .padding (m.EdgeInsets/symmetric .horizontal 10)
                  .child
                  (m/Icon m/Icons.inbox_outlined
                          .color (-> m/Theme (.of ctx) .-iconTheme .-color))))
                (m/Tab
                 .icon
                 (m/Padding
                  .padding (m.EdgeInsets/symmetric .horizontal 10)
                  .child
                  (m/Icon m/Icons.flag_outlined
                          .color (-> m/Theme (.of ctx) .-iconTheme .-color))))
                (m/Tab
                 .icon
                 (m/Padding
                  .padding (m.EdgeInsets/symmetric .horizontal 10)
                  .child
                  (m/Icon m/Icons.archive_outlined
                          .color (-> m/Theme (.of ctx) .-iconTheme .-color))))
                (m/Tab
                 .icon
                 (m/Padding
                  .padding (m.EdgeInsets/symmetric .horizontal 10)
                  .child
                  (m/Icon m/Icons.delete_outlined
                          .color (-> m/Theme (.of ctx) .-iconTheme .-color))))]))])

           (m/Expanded
            .child
            (tabbar-view))])))))))

(defn tabbar-view []
  (f/widget
   :context ctx
   (m/Container
    .color
    (-> m/Theme (.of ctx) .-colorScheme .-primaryContainer)
    .child
    (m/TabBarView
     .children
     [(content-list/widget)
      (content-list/widget)
      (content-list/widget)
      (content-list/widget)]))))
